# ぶんきょう議会ナビ：公開用（本番）の設定のひな形
#
# このファイルを「.env.production」という名前でコピーし、「=」の右に値を書いてください。
# .env.production は .gitignore で除外されているので、GitHub には上がりません。
# このひな形（.env.production.example）には、値を書かないでください（GitHub に上がります）。
#
# .env.production を使うもの（このパソコンの中だけ）:
#   - 管理画面を公開用データベースにつないで動かす:  pnpm dev:admin:prod-db
#   - 会議録を公開用データベースに入れる:            py -3 load_minutes.py --apply --target production
#
# 後半の「Vercel に登録する値」は、Vercel の画面（Settings → Environment Variables）に
# 同じ名前で登録します（公開手順書 STEP 6）。ここは、その控えです。

#=== Supabase（公開用データベース）=====================================
# Supabase → Project Settings → Data API → Project URL（https://xxxx.supabase.co）
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys の anon（public）の鍵
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Project Settings → API Keys の service_role（secret）の鍵。秘密。人に見せない
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Database → Connect → Session pooler の接続文字列（[YOUR-PASSWORD] をパスワードに置き換える）
# load_minutes.py --target production が、ここから接続先を読む
SUPABASE_DB_URL=

#=== 公開サイトの住所 ===================================================
NEXT_PUBLIC_WEB_URL=https://civictech-bunkyo.org

#=== Vercel に登録する値（控え）==========================================
# 管理画面からの「表示の更新」の合図に使う合言葉（ランダムな長い文字列）
REVALIDATE_SECRET=

# 本公開のスイッチ。
#   空のまま（または登録しない）＝プレビュー：パスワードをかけ、検索エンジンに載せない
#   true                     ＝本公開：パスワードを外し、検索エンジンに載せる
# プレビュー中に BASIC_AUTH_USER / BASIC_AUTH_PASSWORD が無いと、だれもサイトを見られない（安全側）
SITE_PUBLIC_RELEASE=

# 全議員プレビュー用のユーザー名とパスワード（議員に配る。ほかで使っているものにしない）
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
